{
  "$schema": "node_modules/wrangler/config-schema.json",

  /*
   * 既定は本番。**公開済みの URL（bodymake.hashiohiro.workers.dev）を動かさない**ため、
   * あとから足したデモのほうに別名を与えている。
   * その URL の localStorage に記録が入っているので、本番の配信先は動かせない。
   *
   *   npm run deploy:prod … 本番。初期データなし
   *   npm run deploy:demo … デモ。作者の実測値を初期データに入れる（VITE_DEMO=1）
   *
   * 別のワーカーなので配信元のオリジンが分かれ、**localStorage も別になる**。
   * デモを触っても本番の記録には影響しない。
   */
  "name": "bodymake",
  "compatibility_date": "2026-08-08",

  // サーバー側のコードは持たない完全な静的配信。
  // Worker スクリプトを置かない場合、assets だけの構成で配信できる。
  "assets": {
    "directory": "./dist",
    // ハッシュルーティングなので通常は使われないが、
    // 存在しないパスを直打ちされたときに 404 ではなくアプリを返す
    "not_found_handling": "single-page-application",
  },

  "observability": {
    "enabled": true,
  },

  "env": {
    /*
     * デモ。作者の実測値を初期データに入れたビルド（npm run build:demo）を配る。
     * assets と observability は環境ごとに書く（環境ブロックへ引き継がれないため）。
     */
    "demo": {
      "name": "bodymake-demo",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
