{
  "name": "bodymake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "体重推移エクセルをスマホから見られるPWAに置き換えたボディメイク進捗トラッカー",
  "license": "MIT",
  "author": "hashiohiro",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-notices.mjs",
    "build": "tsc -b && vite build",
    "build:demo": "npm run build -- --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "vite build --sourcemap && node scripts/licenses.mjs",
    "licenses:check": "vite build --sourcemap && node scripts/licenses.mjs --check && npm run build",
    "cf:login": "wrangler login",
    "cf:check": "wrangler deploy --dry-run && wrangler deploy --dry-run --env demo",
    "deploy:demo": "npm run build:demo && wrangler deploy --env demo",
    "deploy:prod": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.0",
    "sass-embedded": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
