{
  "name": "bodymake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "体重推移エクセルをスマホから見られるPWAに置き換えたボディメイク進捗トラッカー",
  "license": "MIT",
  "author": "hashiohiro",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-notices.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "licenses": "vite build --sourcemap && node scripts/licenses.mjs",
    "licenses:check": "vite build --sourcemap && node scripts/licenses.mjs --check && npm run build",
    "cf:login": "wrangler login",
    "cf:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sass-embedded": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.120.0"
  }
}
